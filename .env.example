# Segredo usado para validar o webhook do OpenWA
OPENWA_WEBHOOK_SECRET=dev-secret

# Eventos assinados no webhook (usado por scripts/register-webhook.sh e dev.sh).
# Inclua o evento de mensagem ENVIADA do OpenWA pra registrar o que o atendente
# humano digita, ex: message.received,message.sent
OPENWA_WEBHOOK_EVENTS=message.received

# URL base da API do OpenWA
OPENWA_API_URL=http://localhost:2785/api

# Chave de API do OpenWA
OPENWA_API_KEY=

# Mongo (histórico de conversas / clientes)
MONGO_URI=mongodb://localhost:27018
MONGO_DB_NAME=chat_service

# OpenRouter (LLM + embeddings)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=inclusionai/ling-3.0-flash-sante:free,qwen/qwen3.8-27b:free,dots-studio/dots-3-note-preview:free

# MySQL (cadastro de beneficiários — bancoFake/ localmente, ou instância
# de produção). Ao rodar via docker-compose use os
# nomes dos serviços (ex: MYSQL_HOST=chat-mysql) em vez de localhost.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=chatservice
MYSQL_DB=beneficiarios
MYSQL_PASSWORD=

# Minutos sem mensagem até o bot perguntar "posso ajudar em algo mais?"
SESSION_TIMEOUT_MINUTES=60
# Minutos esperando resposta a essa pergunta até encerrar o atendimento
SESSION_CLOSE_MINUTES=10
# Depois de encerrado, a próxima mensagem abre uma sessão nova (histórico e identificação zerados)
# Conversa encaminhada pra atendente: bot fica em silêncio até esse tempo sem mensagens
ESCALATION_RELEASE_MINUTES=120

# Horário do atendimento humano (fuso de Brasília; dias 0=segunda ... 6=domingo).
# Fora dele, quem pede cancelamento recebe o passo a passo do app (COMPANY_APP_NAME).
ATENDIMENTO_DIAS=0,1,2,3,4,5
ATENDIMENTO_INICIO=08:00
ATENDIMENTO_FIM=18:00

# boleto-service: consulta os boletos em aberto assim que o CPF é confirmado.
# Na rede do docker-compose use o nome do serviço; rodando fora, http://localhost:3308
BOLETO_SERVICE_URL=http://boleto-service:3308
# Mesmo valor de API_KEY do .env do boleto-service (vazio = consulta desligada)
BOLETO_SERVICE_API_KEY=

# Identidade da empresa e do bot. Também preenchem os {{placeholders}} da
# knowledge_base/ (rode scripts/ingest.py de novo depois de mudar)
BOT_NAME=Iza
COMPANY_NAME=Acme Benefícios
COMPANY_APP_NAME=Acme Clientes
SUPPORT_EMAIL=atendimento@acme.example
OMBUDSMAN_EMAIL=ouvidoria@acme.example
SUPPORT_PHONE=0800 000 0000
SUPPORT_WHATSAPP=(11) 90000-0000
APP_STORE_URL=
PLAY_STORE_URL=

# Conexões simultâneas com o MySQL (pool criado no startup)
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=10
